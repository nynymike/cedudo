namespace Linux {
  entity User = {
    uid: Long,
    gid: Long,
    groups: Set<String>,
    home: String,
    shell: String
  };

  entity Service = {
    environment: String,
    critical: Bool
  };

  entity Host;

  action "read-logs" appliesTo {
    principal: [User],
    resource: [Service],
    context: {
      current_time: Long,
      hour: Long,
      day_of_week: Long,
      is_weekend: Bool,
      date: String,
      hostname: String,
      intruder_risk_level: String,
      local_console: Bool,
      is_remote: Bool,
      interactive: Bool,
      tty: String,
      session_age_seconds: Long,
      login_source_ip: String,
      auth_method: String
    }
  };

  action "restart" appliesTo {
    principal: [User],
    resource: [Service],
    context: {
      current_time: Long,
      hour: Long,
      day_of_week: Long,
      is_weekend: Bool,
      date: String,
      hostname: String,
      intruder_risk_level: String,
      local_console: Bool,
      is_remote: Bool,
      interactive: Bool,
      tty: String,
      session_age_seconds: Long,
      login_source_ip: String,
      auth_method: String
    }
  };

  action "open-shell" appliesTo {
    principal: [User],
    resource: [Host],
    context: {
      current_time: Long,
      hour: Long,
      day_of_week: Long,
      is_weekend: Bool,
      date: String,
      hostname: String,
      intruder_risk_level: String,
      local_console: Bool,
      is_remote: Bool,
      interactive: Bool,
      tty: String,
      session_age_seconds: Long,
      login_source_ip: String,
      auth_method: String
    }
  };
}
