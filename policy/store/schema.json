{
  "Linux": {
    "entityTypes": {
      "User": {
        "shape": {
          "type": "Record",
          "attributes": {
            "uid": { "type": "Long" },
            "gid": { "type": "Long" },
            "groups": {
              "type": "Set",
              "element": { "type": "String" }
            },
            "home": { "type": "String" },
            "shell": { "type": "String" }
          }
        }
      },
      "Service": {
        "shape": {
          "type": "Record",
          "attributes": {
            "environment": { "type": "String" },
            "critical": { "type": "Boolean" }
          }
        }
      },
      "Host": {
        "shape": {
          "type": "Record",
          "attributes": {}
        }
      }
    },
    "actions": {
      "read-logs": {
        "appliesTo": {
          "principalTypes": ["User"],
          "resourceTypes": ["Service"],
          "context": {
            "type": "Record",
            "attributes": {
              "current_time": { "type": "Long" },
              "hostname": { "type": "String" },
              "local_console": { "type": "Boolean" },
              "interactive": { "type": "Boolean" },
              "intruder_risk_level": { "type": "String" }
            }
          }
        }
      },
      "restart": {
        "appliesTo": {
          "principalTypes": ["User"],
          "resourceTypes": ["Service"],
          "context": {
            "type": "Record",
            "attributes": {
              "current_time": { "type": "Long" },
              "hostname": { "type": "String" },
              "local_console": { "type": "Boolean" },
              "interactive": { "type": "Boolean" },
              "intruder_risk_level": { "type": "String" }
            }
          }
        }
      },
      "open-shell": {
        "appliesTo": {
          "principalTypes": ["User"],
          "resourceTypes": ["Host"],
          "context": {
            "type": "Record",
            "attributes": {
              "current_time": { "type": "Long" },
              "hostname": { "type": "String" },
              "local_console": { "type": "Boolean" },
              "interactive": { "type": "Boolean" },
              "intruder_risk_level": { "type": "String" }
            }
          }
        }
      }
    }
  }
}
