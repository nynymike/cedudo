{
  "read-logs": {
    "action_type": "Linux::Action",
    "action_id": "read-logs",
    "resource_type": "Linux::Service",
    "resource_id": "cedar-demo",
    "resource_attributes": {
      "environment": "workshop",
      "critical": false
    },
    "argv": [
      "/usr/bin/journalctl",
      "--unit=cedar-demo.service",
      "--lines=20",
      "--no-pager",
      "--output=short-iso"
    ]
  },
  "restart-demo": {
    "action_type": "Linux::Action",
    "action_id": "restart",
    "resource_type": "Linux::Service",
    "resource_id": "cedar-demo",
    "resource_attributes": {
      "environment": "workshop",
      "critical": false
    },
    "argv": [
      "/usr/bin/systemctl",
      "--no-ask-password",
      "--no-pager",
      "restart",
      "cedar-demo.service"
    ]
  },
  "restart-ssh": {
    "action_type": "Linux::Action",
    "action_id": "restart",
    "resource_type": "Linux::Service",
    "resource_id": "ssh",
    "resource_attributes": {
      "environment": "workshop",
      "critical": true
    },
    "argv": [
      "/usr/bin/echo",
      "SIMULATED: ssh would be restarted here (restart-ssh never runs systemctl)"
    ]
  }
}
