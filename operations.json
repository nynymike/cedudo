{
  "read-logs": {
    "action_type": "Linux::Action",
    "action_id": "read-logs",
    "resource_type": "Linux::Service",
    "resource_id": "cedar-demo",
    "resource_attributes": {
      "environment": "workshop",
      "critical": false
    },
    "argv": [
      "/usr/bin/echo",
      "Dropped you a link to the logs folder on Slack."
    ]
  },
  "restart-demo": {
    "action_type": "Linux::Action",
    "action_id": "restart",
    "resource_type": "Linux::Service",
    "resource_id": "cedar-demo",
    "resource_attributes": {
      "environment": "workshop",
      "critical": false
    },
    "argv": [
      "/usr/bin/echo",
      "Cedar demo is restarting..."
    ]
  },
  "restart-ssh": {
    "action_type": "Linux::Action",
    "action_id": "restart",
    "resource_type": "Linux::Service",
    "resource_id": "ssh",
    "resource_attributes": {
      "environment": "workshop",
      "critical": true
    },
    "argv": [
      "/usr/bin/echo",
      "ssh is restarting..."
    ]
  }
}
